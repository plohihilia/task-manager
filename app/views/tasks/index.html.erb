<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h1>Задачи проекта: <%= @project.name %></h1>
    <%= link_to "Назад к проекту", project_path(@project), class: "btn btn-link" %>
  </div>
  <%= link_to "Новая задача", new_project_task_path(@project), class: "btn btn-primary" %>
</div>

<% if @tasks.empty? %>
  <div class="alert alert-info">
    В этом проекте пока нет задач. <%= link_to "Создай первую!", new_project_task_path(@project) %>
  </div>
<% else %>
  <table class="table table-striped table-hover">
    <thead class="table-dark">
      <tr>
        <th>Название</th>
        <th>Статус</th>
        <th>Описание</th>
        <th class="text-end">Действия</th>
      </tr>
    </thead>
    <tbody>
      <% @tasks.each do |task| %>
        <tr>
          <td>
            <%= link_to task.title, project_task_path(@project, task), class: "text-decoration-none fw-bold" %>
          </td>
          <td>
            <% case task.status %>
            <% when 'todo' %>
              <span class="badge bg-secondary">To Do</span>
            <% when 'in_progress' %>
              <span class="badge bg-warning text-dark">In Progress</span>
            <% when 'done' %>
              <span class="badge bg-success">Done</span>
            <% end %>
          </td>
          <td class="text-muted"><%= truncate(task.description, length: 50) %></td>
          <td class="text-end">
            <%= link_to "Изменить", edit_project_task_path(@project, task), class: "btn btn-sm btn-outline-primary" %>
            <%= button_to "Удалить", project_task_path(@project, task), method: :delete, class: "btn btn-sm btn-outline-danger", form: { style: "display: inline-block" }, data: { turbo_confirm: "Точно удалить?" } %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>