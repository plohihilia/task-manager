<%= form_with(model: [@project, task], class: "needs-validation") do |form| %>
  <% if task.errors.any? %>
    <div class="alert alert-danger">
      <h4><%= pluralize(task.errors.count, "ошибк(а/и)") %> не позволяют сохранить задачу:</h4>
      <ul class="mb-0">
        <% task.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= form.label :title, "Название", class: "form-label" %>
    <%= form.text_field :title, class: "form-control", placeholder: "Введите название задачи" %>
  </div>

  <div class="mb-3">
    <%= form.label :description, "Описание", class: "form-label" %>
    <%= form.text_area :description, class: "form-control", rows: 4, placeholder: "Опишите задачу..." %>
  </div>

  <div class="mb-3">
    <%= form.label :status, "Статус", class: "form-label" %>
    <%= form.select :status, [['To Do', 'todo'], ['In Progress', 'in_progress'], ['Done', 'done']], {}, class: "form-select" %>
  </div>
  
  <div class="mb-3">
    <%= form.label :priority, "Приоритет", class: "form-label" %>
    <%= form.select :priority, [['Низкий', 0], ['Средний', 1], ['Высокий', 2]], {}, class: "form-select" %>
  </div>

  <div class="mb-3">
    <%= form.label :deadline, "Дедлайн", class: "form-label" %>
    <%= form.date_field :deadline, class: "form-control" %>
  </div>
  <div class="d-flex gap-2">
    <%= form.submit class: "btn btn-primary" %>
    <%= link_to "Отмена", project_tasks_path(@project), class: "btn btn-secondary" %>
  </div>
<% end %>