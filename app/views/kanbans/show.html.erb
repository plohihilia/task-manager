<div class="mb-4">
  <div class="d-flex justify-content-between align-items-center">
    <div>
      <h1 class="fw-bold"><%= @project.name %></h1>
      <p class="text-muted"><%= @project.description %></p>
    </div>
    <div>
      <%= link_to "Назад к проекту", project_path(@project), class: "btn btn-outline-secondary" %>
      <%= link_to "Новая задача", new_project_task_path(@project), class: "btn btn-primary" %>
    </div>
  </div>
  
  <!-- Прогресс-бар -->
  <div class="card mb-4 shadow-sm">
    <div class="card-body">
      <div class="d-flex justify-content-between mb-2">
        <span class="fw-bold">Прогресс проекта</span>
        <span class="fw-bold text-primary"><%= @project.progress_percentage %>%</span>
      </div>
      <div class="progress" style="height: 20px; border-radius: 10px;">
        <div class="progress-bar" role="progressbar" style="width: <%= @project.progress_percentage %>%">
          <%= @project.progress_percentage %>%
        </div>
      </div>
      <div class="mt-2 d-flex justify-content-between text-muted small">
        <span><i class="bi bi-circle"></i> To Do: <%= @project.tasks_by_status[:todo] %></span>
        <span><i class="bi bi-arrow-right-circle"></i> In Progress: <%= @project.tasks_by_status[:in_progress] %></span>
        <span><i class="bi bi-check-circle-fill"></i> Done: <%= @project.tasks_by_status[:done] %></span>
      </div>
    </div>
  </div>
</div>

<!-- Kanban доска -->
<div class="row">
  <% %w[todo in_progress done].each do |status| %>
    <div class="col-md-4">
      <div class="card shadow-sm h-100">
        <div class="card-header d-flex justify-content-between align-items-center bg-white">
          <h5 class="mb-0">
            <% case status %>
            <% when 'todo' %>
              <span class="badge bg-secondary">To Do</span>
            <% when 'in_progress' %>
              <span class="badge bg-warning text-dark">In Progress</span>
            <% when 'done' %>
              <span class="badge bg-success">Done</span>
            <% end %>
            <span class="badge bg-light text-dark ms-2"><%= @tasks[status.to_sym].count %></span>
          </h5>
          <!-- Кнопка быстрого создания (Этап 1) -->
          <button class="btn btn-sm btn-outline-primary add-task-btn" data-status="<%= status %>" title="Добавить задачу">
            <i class="bi bi-plus-lg"></i>
          </button>
        </div>
        
        <div class="card-body kanban-column p-2" data-status="<%= status %>" style="min-height: 400px;">
          <% @tasks[status.to_sym].each do |task| %>
            <!-- Улучшенная карточка (Этап 2) -->
            <div class="card mb-2 task-card" data-task-id="<%= task.id %>" draggable="true">
              <div class="card-body p-3">
                <div class="d-flex justify-content-between align-items-start mb-2">
                  <h6 class="card-title mb-0 fw-bold"><%= task.title %></h6>
                  <% case task.priority %>
                  <% when 2 %>
                    <span class="badge bg-danger"><i class="bi bi-arrow-up"></i> Высокий</span>
                  <% when 1 %>
                    <span class="badge bg-warning text-dark"><i class="bi bi-dash"></i> Средний</span>
                  <% else %>
                    <span class="badge bg-info text-dark"><i class="bi bi-arrow-down"></i> Низкий</span>
                  <% end %>
                </div>
                
                <% if task.description.present? %>
                  <p class="card-text text-muted small mb-2">
                    <%= truncate(task.description, length: 80) %>
                  </p>
                <% end %>
                
                <div class="d-flex justify-content-between align-items-center mb-2">
                  <% if task.deadline %>
                    <small class="<%= task.deadline < Date.today && task.status != 'done' ? 'text-danger fw-bold' : 'text-muted' %>">
                      <i class="bi bi-calendar-event"></i> <%= task.deadline.strftime('%d.%m.%Y') %>
                      <% if task.deadline < Date.today && task.status != 'done' %>
                        <i class="bi bi-exclamation-triangle-fill"></i>
                      <% end %>
                    </small>
                  <% end %>
                </div>
                
                <div class="d-flex gap-1 flex-wrap">
                  <%= link_to project_task_path(@project, task), class: "btn btn-sm btn-outline-primary", title: "Открыть" do %>
                    <i class="bi bi-eye"></i>
                  <% end %>
                  
                  <%= link_to edit_project_task_path(@project, task), class: "btn btn-sm btn-outline-secondary", title: "Редактировать" do %>
                    <i class="bi bi-pencil"></i>
                  <% end %>
                  
                  <% if task.status != 'todo' %>
                    <%= button_to update_status_project_kanban_path(@project), 
                        method: :patch, 
                        params: { task_id: task.id, status: 'todo' },
                        class: "btn btn-sm btn-outline-secondary", title: "В To Do" do %>
                      <i class="bi bi-circle"></i>
                    <% end %>
                  <% end %>
                  
                  <% if task.status != 'in_progress' %>
                    <%= button_to update_status_project_kanban_path(@project), 
                        method: :patch, 
                        params: { task_id: task.id, status: 'in_progress' },
                        class: "btn btn-sm btn-outline-warning", title: "В работу" do %>
                      <i class="bi bi-arrow-right-circle"></i>
                    <% end %>
                  <% end %>
                  
                  <% if task.status != 'done' %>
                    <%= button_to update_status_project_kanban_path(@project), 
                        method: :patch, 
                        params: { task_id: task.id, status: 'done' },
                        class: "btn btn-sm btn-outline-success", title: "Завершить" do %>
                      <i class="bi bi-check-circle"></i>
                    <% end %>
                  <% end %>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>
</div>

<!-- Модальное окно быстрого создания (Этап 1) -->
<div class="modal fade" id="quickTaskModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Новая задача</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <%= form_with(url: project_tasks_path(@project), method: :post, local: true) do |form| %>
          <div class="mb-3">
            <%= form.label :title, "Название", class: "form-label" %>
            <%= form.text_field :title, class: "form-control", required: true, autofocus: true %>
          </div>
          <div class="mb-3">
            <%= form.label :description, "Описание", class: "form-label" %>
            <%= form.text_area :description, class: "form-control", rows: 3 %>
          </div>
          <div class="mb-3">
            <%= form.label :priority, "Приоритет", class: "form-label" %>
            <%= form.select :priority, [['Низкий', 0], ['Средний', 1], ['Высокий', 2]], {}, class: "form-select" %>
          </div>
          <div class="mb-3">
            <%= form.label :deadline, "Дедлайн", class: "form-label" %>
            <%= form.date_field :deadline, class: "form-control" %>
          </div>
          <%= form.hidden_field :status, id: "task_status_field" %>
          <div class="d-flex justify-content-end gap-2">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Отмена</button>
            <%= form.submit "Создать", class: "btn btn-primary" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('turbo:load', function() {
    // Drag and Drop
    const taskCards = document.querySelectorAll('.task-card');
    const kanbanColumns = document.querySelectorAll('.kanban-column');
    
    taskCards.forEach(card => {
      card.addEventListener('dragstart', function(e) {
        e.dataTransfer.setData('text/plain', this.dataset.taskId);
        this.classList.add('dragging');
      });
      card.addEventListener('dragend', function() {
        this.classList.remove('dragging');
      });
    });
    
    kanbanColumns.forEach(column => {
      column.addEventListener('dragover', function(e) {
        e.preventDefault();
        this.classList.add('drag-over');
      });
      column.addEventListener('dragleave', function() {
        this.classList.remove('drag-over');
      });
      column.addEventListener('drop', function(e) {
        e.preventDefault();
        this.classList.remove('drag-over');
        const taskId = e.dataTransfer.getData('text/plain');
        const newStatus = this.dataset.status;
        
        fetch('/projects/<%= @project.id %>/kanban/update_status', {
          method: 'PATCH',
          headers: {
            'Content-Type': 'application/json',
            'X-CSRF-Token': '<%= form_authenticity_token %>'
          },
          body: JSON.stringify({ task_id: taskId, status: newStatus })
        }).then(response => response.json())
          .then(data => { if (data.success) location.reload(); });
      });
    });

    // Кнопки "+" для быстрого создания
    document.querySelectorAll('.add-task-btn').forEach(btn => {
      btn.addEventListener('click', function() {
        const status = this.dataset.status;
        document.getElementById('task_status_field').value = status;
        
        // Инициализируем Bootstrap Modal
        const modalElement = document.getElementById('quickTaskModal');
        const modal = new bootstrap.Modal(modalElement);
        modal.show();
      });
    });
  });
</script>

<style>
  /* Улучшенный визуал (Этап 3) */
  .task-card {
    cursor: grab;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    border: 1px solid #e9ecef;
    border-radius: 8px;
  }
  .task-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 16px rgba(0,0,0,0.1);
    border-color: #0d6efd;
  }
  .task-card.dragging {
    cursor: grabbing;
    opacity: 0.5;
    transform: rotate(3deg) scale(1.02);
  }
  .kanban-column {
    transition: all 0.3s ease;
    border-radius: 8px;
    background-color: #f8f9fa;
  }
  .kanban-column.drag-over {
    background-color: #e3f2fd;
    border: 2px dashed #0d6efd;
  }
  .progress-bar {
    transition: width 0.8s ease;
    background: linear-gradient(90deg, #0d6efd 0%, #0dcaf0 100%);
  }
  .add-task-btn {
    transition: all 0.2s ease;
    border-radius: 50%;
    width: 30px;
    height: 30px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .add-task-btn:hover {
    transform: scale(1.1);
    background-color: #0d6efd;
    color: white;
  }
  @keyframes slideIn {
    from { opacity: 0; transform: translateY(-10px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .task-card { animation: slideIn 0.3s ease-out; }
</style>ч