<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h1><%= @project.name %></h1>
    <p class="text-muted"><%= @project.description %></p>
  </div>
  <div>
    <%= link_to "Новая задача", new_project_task_path(@project), class: "btn btn-primary" %>
    <%= link_to "Kanban доска", project_kanban_path(@project), class: "btn btn-success" %>
    <%= link_to "Редактировать", edit_project_path(@project), class: "btn btn-outline-secondary" %>
  </div>
</div>

<%= link_to "Все задачи проекта", project_tasks_path(@project), class: "btn btn-outline-primary mb-3" %>