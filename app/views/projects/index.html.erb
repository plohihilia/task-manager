<div class="d-flex justify-content-between align-items-center mb-4">
  <h1>Мои проекты</h1>
  <%= link_to "Новый проект", new_project_path, class: "btn btn-primary" %>
</div>

<% if @projects.empty? %>
  <div class="alert alert-info">
    У тебя пока нет проектов. <%= link_to "Создай первый!", new_project_path %>
  </div>
<% else %>
  <div class="row">
    <% @projects.each do |project| %>
      <div class="col-md-4 mb-3">
        <div class="card shadow-sm">
          <div class="card-body">
            <h5 class="card-title">
              <%= link_to project.name, project_path(project), class: "text-decoration-none" %>
            </h5>
            <p class="card-text text-muted"><%= project.description %></p>
            <div class="d-flex justify-content-between align-items-center">
              <span class="badge bg-secondary">
                <i class="bi bi-list-task"></i> <%= project.tasks.count %> задач
              </span>
              <div>
                <%= link_to "Открыть", project_path(project), class: "btn btn-sm btn-outline-primary" %>
              </div>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  </div>
<% end %>